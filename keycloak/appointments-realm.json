{
  "realm": "appointments",
  "displayName": "Appointments",
  "enabled": true,
  "sslRequired": "${KC_REALM_SSL_REQUIRED}",

  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "rememberMe": false,

  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,

  "passwordPolicy": "length(12) and notEmail(undefined)",

  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,

  "eventsEnabled": true,
  "eventsExpiration": 7776000,
  "enabledEventTypes": ["LOGIN", "LOGIN_ERROR", "REGISTER", "REGISTER_ERROR", "LOGOUT", "LOGOUT_ERROR", "CODE_TO_TOKEN", "CODE_TO_TOKEN_ERROR", "REFRESH_TOKEN", "REFRESH_TOKEN_ERROR", "UPDATE_EMAIL", "VERIFY_EMAIL", "RESET_PASSWORD", "UPDATE_PASSWORD", "UPDATE_TOTP", "REMOVE_TOTP", "DELETE_ACCOUNT"],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,

  "smtpServer": {
    "host": "${KC_SMTP_HOST}",
    "port": "${KC_SMTP_PORT}",
    "from": "${KC_SMTP_FROM}",
    "fromDisplayName": "Appointments",
    "auth": "${KC_SMTP_AUTH}",
    "user": "${KC_SMTP_USER}",
    "password": "${KC_SMTP_PASSWORD}",
    "starttls": "${KC_SMTP_STARTTLS}",
    "ssl": "false"
  },

  "attributes": {
    "acr.loa.map": "{\"1\":1,\"2\":2}"
  },

  "requiredActions": [
    { "alias": "VERIFY_EMAIL", "name": "Verify Email", "providerId": "VERIFY_EMAIL", "enabled": true, "defaultAction": false, "priority": 10, "config": {} },
    { "alias": "CONFIGURE_TOTP", "name": "Configure OTP", "providerId": "CONFIGURE_TOTP", "enabled": true, "defaultAction": false, "priority": 20, "config": {} },
    { "alias": "UPDATE_PASSWORD", "name": "Update Password", "providerId": "UPDATE_PASSWORD", "enabled": true, "defaultAction": false, "priority": 30, "config": {} },
    { "alias": "UPDATE_EMAIL", "name": "Update Email", "providerId": "UPDATE_EMAIL", "enabled": true, "defaultAction": false, "priority": 40, "config": { "verifyEmail": "true" } },
    { "alias": "delete_account", "name": "Delete Account", "providerId": "delete_account", "enabled": false, "defaultAction": false, "priority": 60, "config": {} }
  ],

  "browserFlow": "browser with step-up",
  "authenticationFlows": [
    {
      "alias": "browser with step-up",
      "description": "Level 1: password. Level 2: password and a one-time code from an authenticator app. The Angular app asks for level 2 when entering the admin area; the backend refuses admin requests below level 2 regardless.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "auth-cookie", "authenticatorFlow": false, "requirement": "ALTERNATIVE", "priority": 10, "userSetupAllowed": false },
        { "flowAlias": "step-up forms", "authenticatorFlow": true, "requirement": "ALTERNATIVE", "priority": 20, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "step-up forms",
      "description": "Sign-in forms by level of authentication",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "flowAlias": "level 1 password", "authenticatorFlow": true, "requirement": "CONDITIONAL", "priority": 10, "userSetupAllowed": false },
        { "flowAlias": "level 2 one-time code", "authenticatorFlow": true, "requirement": "CONDITIONAL", "priority": 20, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "level 1 password",
      "description": "Password",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "conditional-level-of-authentication", "authenticatorConfig": "level 1", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 10, "userSetupAllowed": false },
        { "authenticator": "auth-username-password-form", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 20, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "level 2 one-time code",
      "description": "One-time code from an authenticator app; set one up if missing",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "conditional-level-of-authentication", "authenticatorConfig": "level 2", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 10, "userSetupAllowed": false },
        { "authenticator": "auth-otp-form", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 20, "userSetupAllowed": false }
      ]
    }
  ],
  "authenticatorConfig": [
    { "alias": "level 1", "config": { "loa-condition-level": "1", "loa-max-age": "36000" } },
    { "alias": "level 2", "config": { "loa-condition-level": "2", "loa-max-age": "36000" } }
  ],

  "clients": [
    {
      "clientId": "appointments-web",
      "name": "Appointments web app",
      "description": "The Angular app and Swagger UI. Authorization code with PKCE only.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": ["${KC_WEB_REDIRECT_URI}", "${KC_SWAGGER_REDIRECT_URI}"],
      "webOrigins": ["${KC_WEB_ORIGIN}", "${KC_SWAGGER_ORIGIN}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${KC_WEB_REDIRECT_URI}",
        "oauth2.device.authorization.grant.enabled": "false",
        "acr.loa.map": "{\"1\":1,\"2\":2}"
      },
      "defaultClientScopes": ["basic", "acr", "profile", "email", "web-origins"],
      "optionalClientScopes": ["offline_access"],
      "protocolMappers": [
        {
          "name": "appointments-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "appointments-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "appointments-api",
      "name": "Appointments API",
      "description": "Audience only: names the backend as the receiver of tokens. No flows.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "appointments-backend",
      "name": "Appointments backend",
      "description": "Service account only: deletes a Keycloak account when a customer is erased.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_BACKEND_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],

  "users": [
    {
      "username": "service-account-appointments-backend",
      "enabled": true,
      "serviceAccountClientId": "appointments-backend",
      "clientRoles": { "realm-management": ["manage-users"] }
    }
  ],

  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": ["{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}],\"unmanagedAttributePolicy\":\"ADMIN_EDIT\"}"]
        }
      }
    ]
  }
}
