        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (method, uri) (rate(http_server_requests_milliseconds_count{service_name=\"appointments\",uri!~\"/actuator.*\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{method}} {{uri}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "Errors by status",
      "description": "4xx are mostly client mistakes and rule rejections (409); 429 comes from the rate limits; 5xx are ours",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (rate(http_server_requests_milliseconds_count{service_name=\"appointments\",uri!~\"/actuator.*\",status=~\"4..|5..\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{status}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (limit) (rate(http_server_requests_rate_limited_total{service_name=\"appointments\"}[$__rate_interval]))",
          "refId": "B",
          "legendFormat": "429 {{limit}} limit"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
